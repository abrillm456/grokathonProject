# Demo Mode is the default. Leave DATA_MODE unset or "demo" and the app
# runs with seeded Yale students and localStorage. Missing keys never crash the UI.

# demo | supabase
NEXT_PUBLIC_DATA_MODE=demo

# Required only if NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Used by /api/coach. If empty, the deterministic demo coach answers.
XAI_API_KEY=
GROK_MODEL=grok-3
